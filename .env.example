# Docker image
OPEN_MANIPULATOR_IMAGE=ghcr.io/minihic/open-manipulator-rmins:latest

# ROS 2
ROS_DOMAIN_ID=30
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Hardware
USE_FAKE_HARDWARE=true
ROBOT_DEVICE=/dev/ttyUSB0
VIDEO_DEVICE=/dev/video0
INIT_POSITION=true

# Visualization
START_RVIZ=false
FOXGLOVE_PORT=8765
